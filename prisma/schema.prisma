generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Ticket {
  id              Int       @id @default(autoincrement())
  userPhone       String
  userName        String?
  pcNumber        Int?
  rawMessage      String
  summary         String?
  status          String    @default("open")
  aiDecision      String?
  aiConfidence    Float?
  suggestedScript String?
  scriptExecuted  String?
  executionOutput Json?
  createdAt       DateTime  @default(now())
  resolvedAt      DateTime?

  @@index([status])
  @@index([createdAt])
  @@index([pcNumber])
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TechnicianRole {
  ADMIN
  TECHNICIAN
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageDeliveryStatus {
  RECEIVED
  PENDING
  SENT
  FAILED
}

enum WakeAttemptStatus {
  PACKET_SENT
  SEND_FAILED
}

model Ticket {
  id              Int       @id @default(autoincrement())
  chatId          String?
  profilePictureUrl String?
  profilePictureMimeType String?
  profilePictureData String?
  profilePictureStorageKey String?
  machineId       Int?
  userPhone       String
  userName        String?
  pcNumber        Int?
  rawMessage      String
  summary         String?
  status          String    @default("open")
  aiDecision      String?
  aiConfidence    Float?
  suggestedScript String?
  scriptExecuted  String?
  executionOutput Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt
  resolvedAt      DateTime?
  archivedAt      DateTime?
  messages        TicketMessage[]
  machine         Machine?   @relation(fields: [machineId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([createdAt])
  @@index([chatId, status])
  @@index([archivedAt, updatedAt])
  @@index([machineId])
  @@index([pcNumber])
}

model Technician {
  id            Int             @id @default(autoincrement())
  email         String          @unique
  name          String
  passwordHash  String
  role          TechnicianRole  @default(TECHNICIAN)
  isActive      Boolean         @default(true)
  tokenVersion  Int             @default(0)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  refreshTokens RefreshToken[]
  messages      TicketMessage[]
  wakeAttempts  WakeAttempt[]
}

model TicketMessage {
  id                 Int                   @id @default(autoincrement())
  ticketId           Int
  technicianId       Int?
  direction          MessageDirection
  body               String
  deliveryStatus     MessageDeliveryStatus
  externalMessageId  String?               @unique
  clientRequestId    String?               @unique
  sentAt             DateTime?
  mediaMimeType      String?
  mediaData          String?
  mediaStorageKey    String?
  mediaFileName      String?
  mediaError         String?
  mediaMetadata      Json?
  createdAt          DateTime               @default(now())
  ticket             Ticket                 @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  technician         Technician?            @relation(fields: [technicianId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt, id])
  @@index([technicianId])
}

model Department {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  machines  Machine[]
}

model Machine {
  id               Int           @id @default(autoincrement())
  assetTag         String        @unique
  name             String
  location         String
  macAddress       String        @unique
  broadcastAddress String        @default("255.255.255.255")
  wolPort          Int           @default(9)
  hasProjector     Boolean       @default(false)
  hasPrinter       Boolean       @default(false)
  hasMonitor       Boolean       @default(false)
  hasSpeakers      Boolean       @default(false)
  notes            String?
  isActive         Boolean       @default(true)
  departmentId     Int
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  department       Department    @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  tickets          Ticket[]
  wakeAttempts     WakeAttempt[]

  @@index([departmentId, location])
  @@index([isActive])
}

model WakeAttempt {
  id                 Int               @id @default(autoincrement())
  machineId          Int
  technicianId       Int
  status             WakeAttemptStatus
  macAddressSnapshot String
  targetSnapshot     String
  error              String?
  createdAt          DateTime          @default(now())
  machine            Machine           @relation(fields: [machineId], references: [id], onDelete: Restrict)
  technician         Technician        @relation(fields: [technicianId], references: [id], onDelete: Restrict)

  @@index([machineId, createdAt])
  @@index([technicianId, createdAt])
}

model RefreshToken {
  tokenHash    String     @id
  familyId     String
  technicianId Int
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime   @default(now())
  technician   Technician @relation(fields: [technicianId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([technicianId])
  @@index([expiresAt])
}

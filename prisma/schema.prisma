generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TechnicianRole {
  ADMIN
  TECHNICIAN
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageDeliveryStatus {
  RECEIVED
  PENDING
  SENT
  FAILED
}

model Ticket {
  id              Int       @id @default(autoincrement())
  chatId          String?
  userPhone       String
  userName        String?
  pcNumber        Int?
  rawMessage      String
  summary         String?
  status          String    @default("open")
  aiDecision      String?
  aiConfidence    Float?
  suggestedScript String?
  scriptExecuted  String?
  executionOutput Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt
  resolvedAt      DateTime?
  messages        TicketMessage[]

  @@index([status])
  @@index([createdAt])
  @@index([chatId, status])
  @@index([pcNumber])
}

model Technician {
  id            Int             @id @default(autoincrement())
  email         String          @unique
  name          String
  passwordHash  String
  role          TechnicianRole  @default(TECHNICIAN)
  isActive      Boolean         @default(true)
  tokenVersion  Int             @default(0)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  refreshTokens RefreshToken[]
  messages      TicketMessage[]
}

model TicketMessage {
  id                 Int                   @id @default(autoincrement())
  ticketId           Int
  technicianId       Int?
  direction          MessageDirection
  body               String
  deliveryStatus     MessageDeliveryStatus
  externalMessageId  String?               @unique
  clientRequestId    String?               @unique
  sentAt             DateTime?
  createdAt          DateTime               @default(now())
  ticket             Ticket                 @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  technician         Technician?            @relation(fields: [technicianId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt, id])
  @@index([technicianId])
}

model RefreshToken {
  tokenHash    String     @id
  familyId     String
  technicianId Int
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime   @default(now())
  technician   Technician @relation(fields: [technicianId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([technicianId])
  @@index([expiresAt])
}

{
  "name": "it-helpdesk-ingress",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "WhatsApp Web ingress API for an automated IT helpdesk system.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/scripts/remove-whatsapp-locks.js && node dist/server.js",
    "test": "vitest run",
    "test:e2e-dashboard": "node tests/dashboard.e2e.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:generate": "prisma generate",
    "auth:seed-admin": "tsx prisma/seed.ts",
    "dashboard:dev": "npm --prefix dashboard run dev",
    "dashboard:build": "npm --prefix dashboard run build"
  },
  "dependencies": {
    "@google/genai": "^2.18.0",
    "@prisma/client": "^6.14.0",
    "bcryptjs": "^3.0.3",
    "cookie": "^1.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.2",
    "jose": "^6.2.10",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "qrcode-terminal": "^0.12.0",
    "socket.io": "^4.8.3",
    "whaileys": "^6.5.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.20.1",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/supertest": "^7.2.1",
    "prisma": "^6.14.0",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.2.2",
    "tsx": "^4.23.12",
    "typescript": "^5.9.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20"
  }
}
